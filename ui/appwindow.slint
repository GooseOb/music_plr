import {
    Button,
    LineEdit,
    Slider,
    ListView,
    ScrollView,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SearchIcon } from "icons.slint";
import { Track, PlaylistInfo } from "types.slint";
import { Sidebar } from "sidebar.slint";
import { PlayBar } from "playbar.slint";
import { QueuePanel } from "queue-panel.slint";
import { ContextMenu } from "context-menu.slint";
import { SearchHistory } from "search-history.slint";
import { PickerDialog } from "picker-dialog.slint";
import { DeleteConfirm } from "delete-confirm.slint";
import { PlaybackState } from "playback-state.slint";
export { PlaybackState }
import { ContextMenuState } from "context-menu-state.slint";
export { ContextMenuState }
import { DragState } from "drag-state.slint";
export { DragState }
import { NavigationState } from "navigation-state.slint";
export { NavigationState }
import { QueueState } from "queue-state.slint";
export { QueueState }
import { PlaylistState } from "playlist-state.slint";
export { PlaylistState }
import { SearchState } from "search-state.slint";
export { SearchState }
import { SearchView } from "search-view.slint";
import { PlaylistView } from "playlist-view.slint";
import { RadioView } from "radio-view.slint";

export component AppWindow inherits Window {
    in-out property <int> current-view;
    in-out property <string> playlist-create-name;
    in-out property <string> notification;
    in-out property <string> radio-label;

    in-out property <[Track]> radio-tracks;

    in-out property <int> picker-focused-index: 0;
    in-out property <bool> search-has-focus;

    callback navigate-to(int);
    callback start-song-radio(string);
    callback start-artist-radio(string);
    callback download-track(int);
    callback remove-download(int);
    callback download-current();
    callback add-local-music();
    callback toggle-select(int);
    callback copy-selected();
    callback delete-selected();
    callback paste-clipboard();
    callback start-radio(int);
    callback start-artist(int);
    callback download-or-delete(int);
    callback drag-add-to-playlist(int, int);
    callback reorder-tracks(int, int);
    callback reorder-queue(int, int);
    callback remove-from-queue(int);
    callback clear-selection();
    pure callback resolve-thumbnail(string) -> image;

    title: "Music PLR";
    no-frame: false;
    background: Theme.bg;
    default-font-size: 14px;
    forward-focus: root-focus;
    min-height: 400px;
    search-has-focus: search-text-input.has-focus;
    min-width: sidebar.sidebar-width + 400px;

    VerticalLayout {
        spacing: 0;

        HorizontalLayout {
            spacing: 0;
            vertical-stretch: 1;

            sidebar := Sidebar {
                width: sidebar.sidebar-width;
                notification <=> root.notification;
            }

            Rectangle {
                background: Theme.bg;
                horizontal-stretch: 4;
                min-width: 400px;

                VerticalLayout {
                    padding: Theme.spacing-xl;
                    spacing: Theme.spacing-xs;

                    HorizontalLayout {
                        spacing: Theme.spacing-sm;
                        search-text-input := LineEdit {
                            text: SearchState.search-input-text;
                            placeholder-text: "Search songs, artists, albums...";
                            horizontal-stretch: 1;
                            edited => { SearchState.search-input-changed(self.text); }
                            accepted => { SearchState.search-execute(); }
                        }

                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: Theme.radius-sm;
                            background: search-btn-fs.has-focus ? Theme.bg-hover : Theme.accent;
                            VerticalLayout {
                                alignment: center;
                                SearchIcon {
                                    colorize: Theme.accent-fg;
                                }
                            }

                            search-btn-fs := FocusScope {
                                width: 0px;
                                height: 0px;
                                focus-on-click: false;
                                key-pressed(event) => {
                                    if (event.text == Key.Return || event.text == " ") {
                                        SearchState.search-execute();
                                        accept
                                    } else { reject }
                                }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.up) {
                                        SearchState.search-execute();
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: Theme.spacing-md;
                    }

                    if SearchState.loading: Text {
                        text: "Searching...";
                        color: Theme.fg-secondary;
                    }

                    if !SearchState.loading && SearchState.search-results.length > 0 && PlaylistState.selected-playlist < 0 && current-view != 1: SearchView {
                        playlist-count: PlaylistState.playlist-list.length;
                        sidebar-list-abs-y: sidebar.list-abs-y;
                        sidebar-width: sidebar.sidebar-width;

                        clear-search-focus() => { search-text-input.clear-focus(); SearchState.show-search-history = false; }
                        toggle-select(i) => { root.toggle-select(i); }
                        start-radio(i) => { root.start-radio(i); }
                        start-artist(i) => { root.start-artist(i); }
                        download-or-delete(i) => { root.download-or-delete(i); }
                        drag-add-to-playlist(ti, pi) => { root.drag-add-to-playlist(ti, pi); }
                        resolve-thumbnail(url) => { return root.resolve-thumbnail(url); }
                    }

                    if PlaylistState.selected-playlist >= 0: PlaylistView {
                        playlist-count: PlaylistState.playlist-list.length;
                        sidebar-list-abs-y: sidebar.list-abs-y;
                        sidebar-width: sidebar.sidebar-width;

                        clear-search-focus() => { search-text-input.clear-focus(); SearchState.show-search-history = false; }
                        toggle-select(i) => { root.toggle-select(i); }
                        start-radio(i) => { root.start-radio(i); }
                        start-artist(i) => { root.start-artist(i); }
                        download-or-delete(i) => { root.download-or-delete(i); }
                        add-local-music() => { root.add-local-music(); }
                        drag-add-to-playlist(ti, pi) => { root.drag-add-to-playlist(ti, pi); }
                        reorder-tracks(fi, ti) => { root.reorder-tracks(fi, ti); }
                        resolve-thumbnail(url) => { return root.resolve-thumbnail(url); }
                    }

                    if PlaylistState.selected-playlist < 0 && current-view == 1: RadioView {
                        radio-tracks: root.radio-tracks;
                        radio-label: root.radio-label;
                        playlist-count: PlaylistState.playlist-list.length;
                        sidebar-list-abs-y: sidebar.list-abs-y;
                        sidebar-width: sidebar.sidebar-width;

                        clear-search-focus() => { search-text-input.clear-focus(); SearchState.show-search-history = false; }
                        toggle-select(i) => { root.toggle-select(i); }
                        start-radio(i) => { root.start-radio(i); }
                        start-artist(i) => { root.start-artist(i); }
                        download-or-delete(i) => { root.download-or-delete(i); }
                        drag-add-to-playlist(ti, pi) => { root.drag-add-to-playlist(ti, pi); }
                        resolve-thumbnail(url) => { return root.resolve-thumbnail(url); }
                    }

                    if SearchState.search-results.length == 0 && PlaylistState.selected-playlist < 0 && current-view != 1 && !SearchState.loading: Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Search for music or select a playlist";
                                color: Theme.fg-secondary;
                            }
                        }
                    }
                }
            }

            if QueueState.show-queue: Rectangle {
                horizontal-stretch: 1;
                min-width: 240px;
                clip: true;
                background: Theme.bg-secondary;
                QueuePanel {
                    resolve-thumbnail(url) => { return root.resolve-thumbnail(url); }

                    toggle-select(i) => { root.toggle-select(i); }
                    start-radio(i) => { root.start-radio(i); }
                    start-artist(i) => { root.start-artist(i); }
                    download-or-delete(i) => { root.download-or-delete(i); }
                    remove-from-queue(i) => { root.remove-from-queue(i); }
                    reorder-queue(fi, ti) => { root.reorder-queue(fi, ti); }
                }
            }
        }

        PlayBar { }
    }

    if SearchState.show-search-history && SearchState.search-history-items.length > 0: Rectangle {
        x: sidebar.sidebar-width + 20px;
        y: 60px;
        width: search-text-input.width;
        height: min(SearchState.search-history-items.length * 36px + 2px, 300px);
        background: Theme.bg-elevated;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border;

        SearchHistory {
            selected(index) => {
                SearchState.search-input-text = SearchState.search-history-items[index];
                SearchState.search-history-selected(index);
            }
            delete-item(index) => {
                SearchState.delete-search-history(index);
                search-text-input.focus();
            }
            close() => {
                SearchState.show-search-history = false;
                search-text-input.clear-focus();
            }
        }
    }

    if PlaylistState.show-picker: PickerDialog { }

    if PlaylistState.show-delete-confirm: DeleteConfirm { }

    if DragState.active && DragState.over-sidebar: Rectangle {
        x: DragState.x - sidebar.sidebar-width / 2;
        y: DragState.y - 44px;
        width: sidebar.sidebar-width;
        height: 36px;
        background: Theme.accent;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.accent.brighter(0.2);
        VerticalLayout {
            alignment: center;
            padding-left: Theme.spacing-md;
            padding-right: Theme.spacing-md;
            Text {
                text: "+ Add to Playlist";
                color: Theme.accent-fg;
                font-weight: 700;
                horizontal-alignment: center;
            }
        }
    }

    if DragState.active && DragState.reordering && !DragState.in-queue: Rectangle {
        x: DragState.listview-abs-x;
        y: DragState.listview-abs-y + DragState.drop-line-y;
        width: DragState.listview-width;
        height: 2px;
        background: Theme.accent;
    }

    if ContextMenuState.show: Rectangle {
        background: transparent;
        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up) {
                    ContextMenuState.show = false;
                }
            }
        }

        ContextMenu {
            parent-width: root.width;
            parent-height: root.height;
            start-radio(i) => { root.start-radio(i); ContextMenuState.show = false; }
            start-artist(i) => { root.start-artist(i); ContextMenuState.show = false; }
            download-or-delete(i) => { root.download-or-delete(i); ContextMenuState.show = false; }
            remove-from-queue(i) => { root.remove-from-queue(i); ContextMenuState.show = false; }
        }
    }

    root-focus := FocusScope {
        capture-key-pressed(event) => {
            if (event.text == " ") {
                PlaybackState.toggle-play-pause();
                accept
            } else if (event.text == Key.Escape) {
                if ContextMenuState.show {
                    ContextMenuState.show = false;
                } else if SearchState.show-search-history {
                    SearchState.show-search-history = false;
                } else {
                    clear-selection();
                }
                root-focus.focus();
                accept
            } else if (event.text == Key.Delete) {
                delete-selected();
                accept
            } else if (event.modifiers.control && event.text == "c") {
                copy-selected();
                accept
            } else if (event.modifiers.control && event.text == "v") {
                paste-clipboard();
                accept
            } else {
                reject
            }
        }
    }
}
