import { Button, LineEdit, Slider, ListView, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SearchIcon } from "icons.slint";
import { TrackRow } from "track-row.slint";
import { PlaylistCard } from "playlist-card.slint";
import { Track, PlaylistInfo } from "types.slint";
import { Sidebar } from "sidebar.slint";
import { PlayBar } from "playbar.slint";
import { QueuePanel } from "queue-panel.slint";
import { ContextMenu } from "context-menu.slint";
import { SearchHistory } from "search-history.slint";
import { PickerDialog } from "picker-dialog.slint";
import { DeleteConfirm } from "delete-confirm.slint";

export component AppWindow inherits Window {
    in-out property <int> current-view;
    in-out property <string> search-input-text;
    in-out property <string> playlist-create-name;
    in-out property <bool> loading;
    in-out property <bool> track-loading;
    in-out property <string> notification;
    in-out property <string> radio-label;
    in-out property <bool> can-go-back;
    in-out property <bool> can-go-forward;

    in-out property <string> current-track-id;
    in-out property <bool> is-playing;
    in-out property <float> progress;
    in-out property <float> duration-secs;
    in-out property <float> volume;
    in-out property <string> current-title;
    in-out property <string> current-artist;
    in-out property <image> current-thumbnail;

    in-out property <[Track]> search-results;
    in-out property <[Track]> radio-tracks;
    in-out property <[PlaylistInfo]> playlist-list;
    in-out property <[Track]> playlist-tracks;
    in-out property <[string]> picker-playlists;

    in-out property <int> search-focused-index: 0;
    in-out property <int> playlist-focused-index: 0;
    in-out property <int> radio-focused-index: 0;
    in-out property <int> search-history-focused-index: 0;
    in-out property <int> picker-focused-index: 0;

    in-out property <bool> show-picker;
    in-out property <int> picker-track-idx;
    in-out property <int> selected-playlist;
    in-out property <string> selected-playlist-name;

    in-out property <[string]> search-history-items;
    in-out property <bool> show-search-history: false;
    in-out property <bool> search-has-focus;
    in-out property <string> elapsed-text;
    in-out property <string> total-text;
    in-out property <bool> show-context-menu: false;
    in-out property <int> context-menu-idx: -1;
    in-out property <length> context-menu-x: 0px;
    in-out property <length> context-menu-y: 0px;
    in-out property <bool> context-is-youtube: false;
    in-out property <bool> context-is-downloaded: false;
    in-out property <bool> context-in-playlist: false;

    in-out property <bool> drag-possible;
    in-out property <bool> drag-active;
    in-out property <int> drag-track-idx;
    in-out property <length> drag-x;
    in-out property <length> drag-y;
    in-out property <int> drag-target-playlist: -1;
    in-out property <bool> drag-over-sidebar;
    in-out property <bool> drag-reordering;
    in-out property <int> drop-idx: 0;
    in-out property <length> drop-line-y: 0px;
    in-out property <length> pl-scroll-pos;
    in-out property <length> pl-listview-abs-x;
    in-out property <length> pl-listview-abs-y;
    in-out property <length> pl-listview-width;
    in-out property <length> pl-viewport-y;
    in-out property <length> pl-listview-height;

    in-out property <bool> show-queue;
    in-out property <[Track]> queue-tracks;

    in-out property <bool> show-delete-confirm;
    in-out property <int> delete-confirm-index: -1;

    callback toggle-queue();
    callback navigate-to(int);
    callback navigate-back();
    callback navigate-forward();
    callback search-execute();
    callback search-load-more();
    callback play-track(int);
    callback toggle-play-pause();
    callback next-track();
    callback previous-track();
    callback set-volume(float);
    callback seek(float);
    callback start-song-radio(string);
    callback start-artist-radio(string);
    callback download-track(int);
    callback remove-download(int);
    callback download-current();
    callback add-local-music();
    callback create-playlist();
    callback delete-playlist(int);
    callback select-playlist(int);
    callback add-to-playlist(int);
    callback remove-from-playlist(int);
    callback toggle-picker(int);
    callback close-picker();
    callback search-input-changed(string);
    callback playlist-name-changed(string);
    callback search-history-selected(int);
    callback delete-search-history(int);
    callback toggle-select(int);
    callback copy-selected();
    callback delete-selected();
    callback paste-clipboard();
    callback start-radio(int);
    callback start-artist(int);
    callback download-or-delete(int);
    callback drag-add-to-playlist(int, int);
    callback reorder-tracks(int, int);
    callback clear-selection();
    pure callback resolve-thumbnail(string) -> image;

    title: "Music PLR";
    no-frame: false;
    background: Theme.bg;
    default-font-size: 14px;
    forward-focus: root-focus;
    min-width: 640px;
    min-height: 400px;
    search-has-focus: search-text-input.has-focus;

    VerticalLayout {
        spacing: 0;

        HorizontalLayout {
            spacing: 0;
            vertical-stretch: 1;

            sidebar := Sidebar {
                playlist-list <=> root.playlist-list;
                selected-playlist <=> root.selected-playlist;
                playlist-create-name <=> root.playlist-create-name;
                notification <=> root.notification;
                can-go-back <=> root.can-go-back;
                can-go-forward <=> root.can-go-forward;
                drag-active <=> root.drag-active;
                drag-target-playlist <=> root.drag-target-playlist;
                create-playlist() => { root.create-playlist(); }
                select-playlist(i) => { root.select-playlist(i); }
                navigate-back() => { root.navigate-back(); }
                navigate-forward() => { root.navigate-forward(); }
                playlist-name-changed(text) => { root.playlist-name-changed(text); }
            }

            Rectangle {
                background: Theme.bg;
                horizontal-stretch: 4;
                min-width: 400px;

                VerticalLayout {
                    padding: Theme.spacing-xl;
                    spacing: Theme.spacing-xs;

                    HorizontalLayout {
                        spacing: Theme.spacing-sm;
                        search-text-input := LineEdit {
                            text: search-input-text;
                            placeholder-text: "Search songs, artists, albums...";
                            horizontal-stretch: 1;
                            edited => { search-input-changed(self.text); }
                            accepted => { search-execute(); }
                        }
                        Rectangle {
                            width: 30px; height: 30px; border-radius: Theme.radius-sm; background: search-btn-fs.has-focus ? Theme.bg-hover : Theme.accent;
                            VerticalLayout { alignment: center;
                                SearchIcon { colorize: Theme.accent-fg; }
                            }
                            search-btn-fs := FocusScope {
                                width: 0px; height: 0px;
                                focus-on-click: false;
                                key-pressed(event) => {
                                    if (event.text == Key.Return || event.text == " ") {
                                        search-execute(); accept
                                    } else { reject }
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.up) { search-execute(); }
                                }
                            }
                        }
                    }
                    Rectangle { height: Theme.spacing-md; }

                    if loading : Text { text: "Searching..."; color: Theme.fg-secondary; }

                        if !loading && search-results.length > 0 && selected-playlist < 0 && current-view != 1 : VerticalLayout {
                            spacing: Theme.spacing-xs;
                            Rectangle { height: Theme.spacing-xs; }
                            ListView {
                                vertical-stretch: 1;
                                for t[i] in search-results: TrackRow {
                                    track: t;
                                    thumbnail-image: root.resolve-thumbnail(t.thumbnail);
                                    idx: i;
                                    keyboard-focused: search-fs.has-focus && root.search-focused-index == i;
                                    current-track-id: root.current-track-id;
                                    player-playing: root.is-playing;
                                    in-playlist: false;
                                    context-open: root.show-context-menu && root.context-menu-idx == i;
                                    clear-search-focus => { search-text-input.clear-focus(); root.show-search-history = false; }
                                    play-clicked(index) => { root.play-track(index); }
                                    row-clicked(index) => { root.toggle-select(index); }
                                    start-radio(index) => { root.start-radio(index); }
                                    start-artist(index) => { root.start-artist(index); }
                                    toggle-picker(index) => { root.toggle-picker(index); }
                                    download-or-delete(index) => { root.download-or-delete(index); }
                                    remove-from-playlist(index) => {}
                                    right-clicked(index, abs-x, abs-y) => {
                                        root.context-menu-idx = index;
                                        root.context-menu-x = abs-x;
                                        root.context-menu-y = abs-y;
                                        root.context-is-youtube = t.source == "youtube";
                                        root.context-is-downloaded = t.is-downloaded;
                                        root.context-in-playlist = false;
                                        root.show-context-menu = true;
                                    }
                                    drag-pressed(index, abs-x, abs-y) => {
                                        root.drag-possible = true;
                                        root.drag-track-idx = index;
                                        root.drag-x = abs-x;
                                        root.drag-y = abs-y;
                                    }
                                    drag-moved(index, abs-x, abs-y) => {
                                        if (!root.drag-possible) { return; }
                                        if (!root.drag-active) {
                                            if (abs-x - root.drag-x > 5px || root.drag-x - abs-x > 5px || abs-y - root.drag-y > 5px || root.drag-y - abs-y > 5px) {
                                                root.drag-active = true;
                                            } else { return; }
                                        }
                                        root.drag-x = abs-x;
                                        root.drag-y = abs-y;
                                        root.drag-over-sidebar = abs-x >= 0px && abs-x <= 200px;
                                        root.drag-target-playlist = abs-x >= 0px && abs-x <= 200px && playlist-list.length > 0 ? max(0, min(playlist-list.length - 1, (abs-y - sidebar.list-abs-y) / 44px)) : -1;
                                    }
                                    drag-completed(index, abs-x, abs-y) => {
                                        if (root.drag-active) {
                                            if (root.drag-target-playlist >= 0) {
                                                root.drag-add-to-playlist(index, root.drag-target-playlist);
                                            }
                                            root.drag-active = false;
                                            root.drag-target-playlist = -1;
                                            root.drag-over-sidebar = false;
                                        }
                                        root.drag-possible = false;
                                    }
                                }
                            }
                            Rectangle { height: Theme.spacing-xs; }
                            Button { text: "Load more"; horizontal-stretch: 1; clicked => { search-load-more(); } }
                        }

                    if selected-playlist >= 0 : VerticalLayout {
                        spacing: Theme.spacing-sm;
                        HorizontalLayout {
                            spacing: Theme.spacing-sm;
                            Text { text: selected-playlist-name; color: Theme.fg; horizontal-stretch: 1; }
                            Rectangle {
                                width: 120px; height: 28px; border-radius: Theme.radius-sm;
                                background: del-pl-ta.has-hover ? Theme.bg-hover : transparent;
                                animate background { duration: 150ms; }
                                VerticalLayout { alignment: center;
                                    Text { text: "Delete playlist"; color: Theme.warning; horizontal-alignment: center; }
                                }
                                del-pl-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.up) {
                                            root.delete-confirm-index = root.selected-playlist;
                                            root.show-delete-confirm = true;
                                        }
                                    }
                                }
                            }
                        }
                            pl-listview := ListView {
                                viewport-y <=> root.pl-viewport-y;
                                vertical-stretch: 1;
                                visible: playlist-tracks.length > 0;
                                for t[i] in playlist-tracks: TrackRow {
                                        track: t;
                                        thumbnail-image: root.resolve-thumbnail(t.thumbnail);
                                        idx: i;
                                        keyboard-focused: playlist-fs.has-focus && root.playlist-focused-index == i;
                                        current-track-id: root.current-track-id;
                                        player-playing: root.is-playing;
                                        in-playlist: true;
                                        context-open: root.show-context-menu && root.context-menu-idx == i;
                                        clear-search-focus => { search-text-input.clear-focus(); root.show-search-history = false; }
                                        play-clicked(index) => { root.play-track(index); }
                                        row-clicked(index) => { root.toggle-select(index); }
                                        start-radio(index) => { root.start-radio(index); }
                                        start-artist(index) => { root.start-artist(index); }
                                        toggle-picker(index) => { root.toggle-picker(index); }
                                        download-or-delete(index) => { root.download-or-delete(index); }
                                        remove-from-playlist(index) => { root.remove-from-playlist(index); }
                                        right-clicked(index, abs-x, abs-y) => {
                                            root.context-menu-idx = index;
                                            root.context-menu-x = abs-x;
                                            root.context-menu-y = abs-y;
                                            root.context-is-youtube = t.source == "youtube";
                                            root.context-is-downloaded = t.is-downloaded;
                                            root.context-in-playlist = true;
                                            root.show-context-menu = true;
                                        }
                                        drag-pressed(index, abs-x, abs-y) => {
                                            root.drag-possible = true;
                                            root.drag-track-idx = index;
                                            root.drag-x = abs-x;
                                            root.drag-y = abs-y;
                                            root.pl-listview-abs-x = pl-listview.absolute-position.x;
                                            root.pl-listview-abs-y = pl-listview.absolute-position.y;
                                            root.pl-listview-width = pl-listview.width;
                                            root.pl-listview-height = pl-listview.height;
                                            root.drop-idx = index;
                                        }
                                        drag-moved(index, abs-x, abs-y) => {
                                            if (!root.drag-possible) { return; }
                                            if (!root.drag-active) {
                                                if (abs-x - root.drag-x > 5px || root.drag-x - abs-x > 5px || abs-y - root.drag-y > 5px || root.drag-y - abs-y > 5px) {
                                                    root.drag-active = true;
                                                    root.drag-reordering = true;
                                                } else { return; }
                                            }
                                            root.drag-x = abs-x;
                                            root.drag-y = abs-y;
                                            root.drag-over-sidebar = abs-x >= 0px && abs-x <= 200px;
                                            root.drag-target-playlist = abs-x >= 0px && abs-x <= 200px && playlist-list.length > 0 ? max(0, min(playlist-list.length - 1, (abs-y - sidebar.list-abs-y) / 44px)) : -1;
                                            root.drag-reordering = abs-x > 200px;
                                            if (root.drag-reordering) {
                                                let rel-y = abs-y - pl-listview.absolute-position.y;
                                                let edge-zone = 40px;
                                                if (rel-y < edge-zone) {
                                                    pl-listview.viewport-y = min(0px, pl-listview.viewport-y + 8px);
                                                } else if (rel-y > pl-listview.height - edge-zone) {
                                                    let max-scroll = -(max(0px, playlist-tracks.length * 48px - pl-listview.height));
                                                    pl-listview.viewport-y = max(max-scroll, pl-listview.viewport-y - 8px);
                                                }
                                                root.drop-idx = max(0, min(playlist-tracks.length, (rel-y - pl-listview.viewport-y) / 48px + 0.5));
                                                root.drop-line-y = max(0px, min(pl-listview.height - 2px, root.drop-idx * 48px + pl-listview.viewport-y));
                                            }
                                        }
                                        drag-completed(index, abs-x, abs-y) => {
                                            if (root.drag-active) {
                                                if (root.drag-target-playlist >= 0) {
                                                    root.drag-add-to-playlist(index, root.drag-target-playlist);
                                                } else if (root.drag-reordering && root.drop-idx != root.drag-track-idx) {
                                                    root.reorder-tracks(root.drag-track-idx, root.drop-idx);
                                                }
                                                root.drag-active = false;
                                                root.drag-target-playlist = -1;
                                                root.drag-over-sidebar = false;
                                                root.drag-reordering = false;
                                            }
                                            root.drag-possible = false;
                                        }
                                    }
                                }

                            if playlist-tracks.length == 0 : Rectangle {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "No tracks yet. Add local music or add from Search.";
                                    color: Theme.fg-secondary;
                                }
                            }
                        }
                        Button { text: "Add Local Music"; horizontal-stretch: 1; clicked => { add-local-music(); } }
                    }

                    if selected-playlist < 0 && current-view == 1 : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: Theme.spacing-xs;
                            if radio-label != "" : Text { text: radio-label; color: Theme.fg; }
                            if loading && radio-tracks.length == 0 : Text { text: "Loading recommendations..."; color: Theme.fg-secondary; }
                            if radio-tracks.length > 0 : ListView {
                                vertical-stretch: 1;
                                for t[i] in radio-tracks: TrackRow {
                                    track: t;
                                    thumbnail-image: root.resolve-thumbnail(t.thumbnail);
                                    idx: i;
                                    keyboard-focused: radio-fs.has-focus && root.radio-focused-index == i;
                                    current-track-id: root.current-track-id;
                                    player-playing: root.is-playing;
                                    in-playlist: false;
                                    context-open: root.show-context-menu && root.context-menu-idx == i;
                                    clear-search-focus => { search-text-input.clear-focus(); root.show-search-history = false; }
                                    play-clicked(index) => { root.play-track(index); }
                                    row-clicked(index) => { root.toggle-select(index); }
                                    start-radio(index) => { root.start-radio(index); }
                                    start-artist(index) => { root.start-artist(index); }
                                    toggle-picker(index) => { root.toggle-picker(index); }
                                    download-or-delete(index) => { root.download-or-delete(index); }
                                    remove-from-playlist(index) => {}
                                    right-clicked(index, abs-x, abs-y) => {
                                        root.context-menu-idx = index;
                                        root.context-menu-x = abs-x;
                                        root.context-menu-y = abs-y;
                                        root.context-is-youtube = t.source == "youtube";
                                        root.context-is-downloaded = t.is-downloaded;
                                        root.context-in-playlist = false;
                                        root.show-context-menu = true;
                                    }
                                    drag-pressed(index, abs-x, abs-y) => {
                                        root.drag-possible = true;
                                        root.drag-track-idx = index;
                                        root.drag-x = abs-x;
                                        root.drag-y = abs-y;
                                    }
                                    drag-moved(index, abs-x, abs-y) => {
                                        if (!root.drag-possible) { return; }
                                        if (!root.drag-active) {
                                            if (abs-x - root.drag-x > 5px || root.drag-x - abs-x > 5px || abs-y - root.drag-y > 5px || root.drag-y - abs-y > 5px) {
                                                root.drag-active = true;
                                            } else { return; }
                                        }
                                        root.drag-x = abs-x;
                                        root.drag-y = abs-y;
                                        root.drag-over-sidebar = abs-x >= 0px && abs-x <= 200px;
                                        root.drag-target-playlist = abs-x >= 0px && abs-x <= 200px && playlist-list.length > 0 ? max(0, min(playlist-list.length - 1, (abs-y - sidebar.list-abs-y) / 44px)) : -1;
                                    }
                                    drag-completed(index, abs-x, abs-y) => {
                                        if (root.drag-active) {
                                            if (root.drag-target-playlist >= 0) {
                                                root.drag-add-to-playlist(index, root.drag-target-playlist);
                                            }
                                            root.drag-active = false;
                                            root.drag-target-playlist = -1;
                                            root.drag-over-sidebar = false;
                                        }
                                        root.drag-possible = false;
                                    }
                                }
                            }
                            if radio-tracks.length == 0 && !loading : Text {
                            text: "Search for a song first, then use Radio or Artist";
                            color: Theme.fg-secondary;
                        }
                    }

                    if search-results.length == 0 && selected-playlist < 0 && current-view != 1 && !loading : Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Search for music or select a playlist";
                                color: Theme.fg-secondary;
                            }
                        }
                    }
                }

                search-fs := FocusScope {
                    width: 0px; height: 0px;
                    focus-on-click: false;
                    key-pressed(event) => {
                        if (event.text == Key.DownArrow) {
                            root.search-focused-index = (root.search-focused-index + 1).min(search-results.length - 1);
                            accept
                        } else if (event.text == Key.UpArrow) {
                            root.search-focused-index = (root.search-focused-index - 1).max(0);
                            accept
                        } else if (event.text == Key.Return) {
                            root.play-track(root.search-focused-index);
                            accept
                        } else if (event.text == Key.Delete) {
                            root.download-or-delete(root.search-focused-index);
                            accept
                        } else { reject }
                    }
                }
                playlist-fs := FocusScope {
                    width: 0px; height: 0px;
                    focus-on-click: false;
                    key-pressed(event) => {
                        if (event.text == Key.DownArrow) {
                            root.playlist-focused-index = (root.playlist-focused-index + 1).min(playlist-tracks.length - 1);
                            accept
                        } else if (event.text == Key.UpArrow) {
                            root.playlist-focused-index = (root.playlist-focused-index - 1).max(0);
                            accept
                        } else if (event.text == Key.Return) {
                            root.play-track(root.playlist-focused-index);
                            accept
                        } else if (event.text == Key.Delete) {
                            root.remove-from-playlist(root.playlist-focused-index);
                            accept
                        } else { reject }
                    }
                }
                radio-fs := FocusScope {
                    width: 0px; height: 0px;
                    focus-on-click: false;
                    key-pressed(event) => {
                        if (event.text == Key.DownArrow) {
                            root.radio-focused-index = (root.radio-focused-index + 1).min(radio-tracks.length - 1);
                            accept
                        } else if (event.text == Key.UpArrow) {
                            root.radio-focused-index = (root.radio-focused-index - 1).max(0);
                            accept
                        } else if (event.text == Key.Return) {
                            root.play-track(root.radio-focused-index);
                            accept
                        } else if (event.text == Key.Delete) {
                            root.download-or-delete(root.radio-focused-index);
                            accept
                        } else { reject }
                    }
                }
            }

        if root.show-queue : Rectangle {
            horizontal-stretch: 1;
            min-width: 240px;
            clip: true;
            background: Theme.bg-secondary;
            QueuePanel {
                queue-tracks <=> root.queue-tracks;
                current-thumbnail: root.current-thumbnail;
                current-title: root.current-title;
                current-artist: root.current-artist;
                toggle-queue() => { root.toggle-queue(); }
                resolve-thumbnail(url) => { return root.resolve-thumbnail(url); }
            }
        }
        }

        PlayBar {
            current-thumbnail: root.current-thumbnail;
            current-title: root.current-title;
            current-artist: root.current-artist;
            is-playing: root.is-playing;
            progress <=> root.progress;
            volume <=> root.volume;
            elapsed-text: root.elapsed-text;
            total-text: root.total-text;
            track-loading: root.track-loading;
            show-queue: root.show-queue;
            toggle-play-pause() => { root.toggle-play-pause(); }
            previous-track() => { root.previous-track(); }
            next-track() => { root.next-track(); }
            seek(v) => { root.seek(v); }
            set-volume(v) => { root.set-volume(v); }
            toggle-queue() => { root.toggle-queue(); }
        }
    }

    if root.show-search-history && root.search-history-items.length > 0 : Rectangle {
        x: 220px;
        y: 60px;
        width: parent.width - 278px;
        height: min(root.search-history-items.length * 36px + 2px, 300px);
        background: Theme.bg-elevated;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border;

        SearchHistory {
            search-history-items <=> root.search-history-items;
            search-history-focused-index <=> root.search-history-focused-index;
            selected(index) => {
                search-input-text = root.search-history-items[index];
                root.search-history-selected(index);
            }
            delete-item(index) => {
                root.delete-search-history(index);
                search-text-input.focus();
            }
            close() => {
                show-search-history = false;
                search-text-input.clear-focus();
            }
        }
    }

    if show-picker : PickerDialog {
        show-picker <=> root.show-picker;
        picker-playlists <=> root.picker-playlists;
        picker-focused-index <=> root.picker-focused-index;
        add-to-playlist(i) => { root.add-to-playlist(i); }
        close-picker() => { root.close-picker(); }
    }

    if root.show-delete-confirm : DeleteConfirm {
        show-delete-confirm <=> root.show-delete-confirm;
        delete-confirm-index <=> root.delete-confirm-index;
        delete-playlist(i) => { root.delete-playlist(i); }
    }

    if root.drag-active && root.drag-over-sidebar : Rectangle {
        x: root.drag-x - 100px;
        y: root.drag-y - 44px;
        width: 200px;
        height: 36px;
        background: Theme.accent;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.accent.brighter(0.2);
        VerticalLayout {
            alignment: center;
            padding-left: Theme.spacing-md;
            padding-right: Theme.spacing-md;
            Text {
                text: "+ Add to Playlist";
                color: Theme.accent-fg;
                font-weight: 700;
                horizontal-alignment: center;
            }
        }
    }

    if root.drag-active && root.drag-reordering : Rectangle {
        x: root.pl-listview-abs-x;
        y: root.pl-listview-abs-y + root.drop-line-y;
        width: root.pl-listview-width;
        height: 2px;
        background: Theme.accent;
    }

    if root.drag-active : Rectangle {
        background: transparent;
        overlay-ta := TouchArea {
            mouse-cursor: move;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.move) {
                    let mx = overlay-ta.mouse-x;
                    let my = overlay-ta.mouse-y;
                    root.drag-x = mx;
                    root.drag-y = my;
                    root.drag-over-sidebar = mx >= 0px && mx <= 200px;
                    root.drag-target-playlist = mx >= 0px && mx <= 200px && playlist-list.length > 0 ? max(0, min(playlist-list.length - 1, (my - sidebar.list-abs-y) / 44px)) : -1;
                    if (root.selected-playlist >= 0) {
                        root.drag-reordering = mx > 200px;
                        if (root.drag-reordering) {
                            let rel-y = my - root.pl-listview-abs-y;
                            let edge-zone = 40px;
                            if (rel-y < edge-zone) {
                                root.pl-viewport-y = min(0px, root.pl-viewport-y + 8px);
                            } else if (rel-y > root.pl-listview-height - edge-zone) {
                                let max-scroll = -(max(0px, playlist-tracks.length * 48px - root.pl-listview-height));
                                root.pl-viewport-y = max(max-scroll, root.pl-viewport-y - 8px);
                            }
                            root.drop-idx = max(0, min(playlist-tracks.length, (rel-y - root.pl-viewport-y) / 48px + 0.5));
                            root.drop-line-y = max(0px, min(root.pl-listview-height - 2px, root.drop-idx * 48px + root.pl-viewport-y));
                        }
                    }
                } else if (event.kind == PointerEventKind.up) {
                    if (root.drag-target-playlist >= 0) {
                        root.drag-add-to-playlist(root.drag-track-idx, root.drag-target-playlist);
                    } else if (root.drag-reordering && root.drop-idx != root.drag-track-idx) {
                        root.reorder-tracks(root.drag-track-idx, root.drop-idx);
                    }
                    root.drag-active = false;
                    root.drag-target-playlist = -1;
                    root.drag-over-sidebar = false;
                    root.drag-reordering = false;
                    root.drag-possible = false;
                }
            }
        }
    }

    if root.show-context-menu : Rectangle {
        background: transparent;
        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up) { root.show-context-menu = false; }
            }
        }
        ContextMenu {
            context-menu-idx <=> root.context-menu-idx;
            context-menu-x <=> root.context-menu-x;
            context-menu-y <=> root.context-menu-y;
            context-is-youtube <=> root.context-is-youtube;
            context-is-downloaded <=> root.context-is-downloaded;
            context-in-playlist <=> root.context-in-playlist;
            parent-width: root.width;
            parent-height: root.height;
            start-radio(i) => { root.start-radio(i); root.show-context-menu = false; }
            start-artist(i) => { root.start-artist(i); root.show-context-menu = false; }
            toggle-picker(i) => { root.toggle-picker(i); root.show-context-menu = false; }
            download-or-delete(i) => { root.download-or-delete(i); root.show-context-menu = false; }
            remove-from-playlist(i) => { root.remove-from-playlist(i); root.show-context-menu = false; }
        }
    }

    root-focus := FocusScope {
        capture-key-pressed(event) => {
            if (event.text == " ") {
                toggle-play-pause();
                accept
            } else if (event.text == Key.Escape) {
                if root.show-context-menu {
                    root.show-context-menu = false;
                } else if show-search-history {
                    show-search-history = false;
                } else {
                    clear-selection();
                }
                root-focus.focus();
                accept
            } else if (event.text == Key.Delete) {
                delete-selected();
                accept
            } else if (event.modifiers.control && event.text == "c") {
                copy-selected();
                accept
            } else if (event.modifiers.control && event.text == "v") {
                paste-clipboard();
                accept
            } else {
                reject
            }
        }
    }
}
