import { Button, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Track } from "types.slint";
import { TrackRow } from "track-row.slint";
import { PlaybackState } from "playback-state.slint";
import { ContextMenuState } from "context-menu-state.slint";
import { DragState } from "drag-state.slint";
import { PlaylistState } from "playlist-state.slint";

export component PlaylistView {
    in property <int> playlist-count;
    in property <length> sidebar-list-abs-y;
    in property <length> sidebar-width;

    callback clear-search-focus();
    callback toggle-select(int);
    callback start-radio(int);
    callback start-artist(int);
    callback download-or-delete(int);
    callback add-local-music();
    callback drag-add-to-playlist(int, int);
    callback reorder-tracks(int, int);
    pure callback resolve-thumbnail(string) -> image;

    property <int> focused-index: 0;

    VerticalLayout {
        spacing: Theme.spacing-sm;
        HorizontalLayout {
            spacing: Theme.spacing-sm;
            Text {
                text: PlaylistState.selected-playlist-name;
                color: Theme.fg;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 120px;
                height: 28px;
                border-radius: Theme.radius-sm;
                background: del-pl-ta.has-hover ? Theme.bg-hover : transparent;
                animate background { duration: 150ms; }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Delete playlist";
                        color: Theme.warning;
                        horizontal-alignment: center;
                    }
                }

                del-pl-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        PlaylistState.delete-confirm-index = PlaylistState.selected-playlist;
                        PlaylistState.show-delete-confirm = true;
                    }
                }
            }
        }

        pl-listview := ListView {
            viewport-y <=> DragState.viewport-y;
            vertical-stretch: 1;
            visible: PlaylistState.playlist-tracks.length > 0;
            for t[i] in PlaylistState.playlist-tracks: TrackRow {
                track: t;
                thumbnail-image: root.resolve-thumbnail(t.thumbnail);
                idx: i;
                keyboard-focused: playlist-fs.has-focus && root.focused-index == i;
                in-playlist: true;
                in-queue: false;
                clear-search-focus => { root.clear-search-focus(); }
                row-clicked(index) => { root.toggle-select(index); }
                start-radio(index) => { root.start-radio(index); }
                start-artist(index) => { root.start-artist(index); }
                toggle-picker(index) => { PlaylistState.toggle-picker(index); }
                download-or-delete(index) => { root.download-or-delete(index); }
                remove-from-playlist(index) => { PlaylistState.remove-from-playlist(index); }
                right-clicked(index, abs-x, abs-y) => {
                    ContextMenuState.idx = index;
                    ContextMenuState.x = abs-x;
                    ContextMenuState.y = abs-y;
                    ContextMenuState.is-youtube = t.source == "youtube";
                    ContextMenuState.is-downloaded = t.is-downloaded;
                    ContextMenuState.in-playlist = true;
                    ContextMenuState.show = true;
                }
                drag-pressed(index, abs-x, abs-y) => {
                    DragState.possible = true;
                    DragState.track-idx = index;
                    DragState.x = abs-x;
                    DragState.y = abs-y;
                    DragState.in-queue = false;
                    DragState.listview-abs-x = pl-listview.absolute-position.x;
                    DragState.listview-abs-y = pl-listview.absolute-position.y;
                    DragState.listview-width = pl-listview.width;
                    DragState.listview-height = pl-listview.height;
                    DragState.drop-idx = index;
                }
                drag-moved(index, abs-x, abs-y) => {
                    if (!DragState.possible) { return; }
                    if (!DragState.active) {
                        if (abs-x - DragState.x > 5px || DragState.x - abs-x > 5px || abs-y - DragState.y > 5px || DragState.y - abs-y > 5px) {
                            DragState.active = true;
                            DragState.reordering = true;
                        } else { return; }
                    }
                    DragState.x = abs-x;
                    DragState.y = abs-y;
                    DragState.over-sidebar = abs-x >= 0px && abs-x <= root.sidebar-width;
                    DragState.target-playlist = abs-x >= 0px && abs-x <= root.sidebar-width && root.playlist-count > 0 ? max(0, min(root.playlist-count - 1, (abs-y - root.sidebar-list-abs-y) / 44px)) : -1;
                    DragState.reordering = abs-x > root.sidebar-width;
                    if (DragState.reordering) {
                        let rel-y = abs-y - pl-listview.absolute-position.y;
                        let edge-zone = 40px;
                        if (rel-y < edge-zone) {
                            DragState.viewport-y = min(0px, DragState.viewport-y + 8px);
                        } else if (rel-y > pl-listview.height - edge-zone) {
                            let max-scroll = -(max(0px, PlaylistState.playlist-tracks.length * 48px - pl-listview.height));
                            DragState.viewport-y = max(max-scroll, DragState.viewport-y - 8px);
                        }
                        DragState.drop-idx = max(0, min(PlaylistState.playlist-tracks.length, (rel-y - DragState.viewport-y) / 48px + 0.5));
                        DragState.drop-line-y = max(0px, min(pl-listview.height - 2px, DragState.drop-idx * 48px + DragState.viewport-y));
                    }
                }
                drag-completed(index, abs-x, abs-y) => {
                    if (DragState.active) {
                        if (DragState.target-playlist >= 0) {
                            root.drag-add-to-playlist(index, DragState.target-playlist);
                        } else if (DragState.reordering && DragState.drop-idx != DragState.track-idx) {
                            root.reorder-tracks(DragState.track-idx, DragState.drop-idx);
                        }
                        DragState.active = false;
                        DragState.target-playlist = -1;
                        DragState.over-sidebar = false;
                        DragState.reordering = false;
                    }
                    DragState.possible = false;
                }
            }
        }

        if PlaylistState.playlist-tracks.length == 0: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                Text {
                    text: "No tracks yet. Add local music or add from Search.";
                    color: Theme.fg-secondary;
                }
            }
        }
        Button {
            text: "Add Local Music";
            horizontal-stretch: 1;
            clicked => { root.add-local-music(); }
        }
    }

    playlist-fs := FocusScope {
        width: 0px;
        height: 0px;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                root.focused-index = (root.focused-index + 1).min(PlaylistState.playlist-tracks.length - 1);
                accept
            } else if (event.text == Key.UpArrow) {
                root.focused-index = (root.focused-index - 1).max(0);
                accept
            } else if (event.text == Key.Return) {
                PlaybackState.play-track(root.focused-index);
                accept
            } else if (event.text == Key.Delete) {
                PlaylistState.remove-from-playlist(root.focused-index);
                accept
            } else { reject }
        }
    }
}
