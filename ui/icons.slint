import { Theme } from "theme.slint";

export component IconBase {
    in property <brush> colorize: Theme.accent-fg;
    in property <image> icon-source;
    in property <length> size: Theme.icon-size-md;
    Rectangle {
        width: root.size;
        height: root.size;
        Image {
            source: root.icon-source;
            width: 100%;
            height: 100%;
            colorize: root.colorize;
        }
    }
}

export component PlayIcon {
    in property <brush> colorize: Theme.accent-fg;
    IconBase {
        colorize: root.colorize;
        icon-source: @image-url("../icons/play.svg");
        size: Theme.icon-size-sm;
    }
}

export component PauseIcon {
    in property <brush> colorize: Theme.accent-fg;
    IconBase {
        colorize: root.colorize;
        icon-source: @image-url("../icons/pause.svg");
        size: Theme.icon-size-sm;
    }
}

export component SkipBackIcon {
    in property <brush> colorize: Theme.fg;
    IconBase {
        colorize: root.colorize;
        icon-source: @image-url("../icons/skip-back.svg");
        size: Theme.icon-size-lg;
    }
}

export component SkipForwardIcon {
    in property <brush> colorize: Theme.fg;
    IconBase {
        colorize: root.colorize;
        icon-source: @image-url("../icons/skip-forward.svg");
        size: Theme.icon-size-lg;
    }
}

export component SearchIcon {
    in property <brush> colorize: Theme.accent-fg;
    IconBase {
        colorize: root.colorize;
        icon-source: @image-url("../icons/search.svg");
        size: Theme.icon-size-md;
    }
}

export component DownloadIcon {
    in property <brush> colorize: Theme.accent;
    IconBase {
        colorize: root.colorize;
        icon-source: @image-url("../icons/download.svg");
        size: Theme.icon-size-md;
    }
}

export component FolderIcon {
    in property <brush> colorize: Theme.fg-secondary;
    IconBase {
        colorize: root.colorize;
        icon-source: @image-url("../icons/folder.svg");
        size: Theme.icon-size-md;
