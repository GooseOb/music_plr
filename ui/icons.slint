export component DeleteIcon {
    in property <brush> colorize: Theme.fg-secondary;
    IconBase {
        colorize: root.colorize;
        icon-source: @image-url("../icons/delete.svg");
        size: Theme.icon-size-sm;
    }
}

export component NavIcon {
    in property <brush> colorize: Theme.fg;
    in property <bool> flipped: false;
    IconBase {
        colorize: root.colorize;
        icon-source: @image-url("../icons/chevron-right.svg");
        size: Theme.icon-size-md;
        transform-rotation: root.flipped ? 180deg : 0deg;
    }
}

export component VolumeIcon {
    in property <brush> colorize: Theme.fg-secondary;
    IconBase {
        colorize: root.colorize;
        icon-source: @image-url("../icons/volume.svg");
        size: Theme.icon-size-md;
    }
}

export component QueueListIcon {
    in property <brush> colorize: Theme.fg;
    Rectangle {
        width: Theme.icon-size-lg;
        height: Theme.icon-size-lg;
        VerticalLayout {
            spacing: 3px;
            padding: 2px;
            Rectangle {
                height: 2px;
                border-radius: 1px;
                background: colorize;
            }

            Rectangle {
                height: 2px;
                border-radius: 1px;
                background: colorize;
            }

            Rectangle {
                height: 2px;
                border-radius: 1px;
                background: colorize;
            }
        }
    }
}
