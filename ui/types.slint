export struct Track {
    id: string,
    title: string,
    artist: string,
    duration: int,
    duration-text: string,
    url: string,
    source: string,
    is-downloaded: bool,
    is-downloading: bool,
    is-selected: bool,
    thumbnail: string,
}

export struct PlaylistInfo {
    name: string,
    track-count: int,
}
