import { Button, LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NavIcon, DeleteIcon } from "icons.slint";
import { PlaylistInfo } from "types.slint";
import { PlaylistCard } from "playlist-card.slint";
import { DragState } from "drag-state.slint";
import { NavigationState } from "navigation-state.slint";
import { PlaylistState } from "playlist-state.slint";

export component Sidebar {
    in-out property <string> notification;

    callback create-playlist();
    callback select-playlist(int);
    callback playlist-name-changed(string);

    in-out property <length> list-abs-y;
    list-abs-y: playlist-list-area.absolute-position.y;
    in property <length> sidebar-width: 300px;

    sidebar-root := Rectangle {
        width: sidebar-width;
        background: Theme.bg-secondary;
        VerticalLayout {
            padding: Theme.spacing-lg;
            spacing: Theme.spacing-sm;

            Text {
                text: "Music PLR";
                color: Theme.accent;
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                spacing: Theme.spacing-xs;
                Rectangle {
                    background: back-fs.has-focus ? Theme.bg-hover : NavigationState.can-go-back ? transparent : Theme.border;
                    border-radius: Theme.radius-sm;
                    horizontal-stretch: 1;
                    height: 22px;
                    VerticalLayout {
                        alignment: center;
                        NavIcon {
                            colorize: NavigationState.can-go-back ? Theme.fg : Theme.fg-muted;
                            flipped: true;
                        }
                    }

                    back-fs := FocusScope {
                        width: 0px;
                        height: 0px;
                        focus-on-click: false;
                        enabled: NavigationState.can-go-back;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == " ") {
                                NavigationState.navigate-back();
                                accept
                            } else { reject }
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        enabled: NavigationState.can-go-back;
                        clicked => {
                            NavigationState.navigate-back();
                        }
                    }
                }

                Rectangle {
                    background: forward-fs.has-focus ? Theme.bg-hover : NavigationState.can-go-forward ? transparent : Theme.border;
                    border-radius: Theme.radius-sm;
                    horizontal-stretch: 1;
                    height: 22px;
                    VerticalLayout {
                        alignment: center;
                        NavIcon {
                            colorize: NavigationState.can-go-forward ? Theme.fg : Theme.fg-muted;
                            flipped: false;
                        }
                    }

                    forward-fs := FocusScope {
                        width: 0px;
                        height: 0px;
                        focus-on-click: false;
                        enabled: NavigationState.can-go-forward;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == " ") {
                                NavigationState.navigate-forward();
                                accept
                            } else { reject }
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        enabled: NavigationState.can-go-forward;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up) { NavigationState.navigate-forward(); }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                spacing: Theme.spacing-xs;
                Text {
                    text: "Playlists";
                    color: Theme.accent;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                spacing: Theme.spacing-xs;
                LineEdit {
                    text: PlaylistState.playlist-create-name;
                    placeholder-text: "New playlist...";
                    edited => { PlaylistState.playlist-name-changed(self.text); }
                    accepted => { PlaylistState.create-playlist(); }
                }

                Rectangle {
                    width: self.height;
                    border-radius: Theme.radius-sm;
                    background: add-pl-touch.has-hover ? Theme.bg-hover : Theme.accent;
                    animate background { duration: 150ms; }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: "+";
                                color: Theme.accent-fg;
                            }
                        }
                    }

                    add-pl-touch := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up) { PlaylistState.create-playlist(); }
                        }
                    }
                }
            }

            playlist-list-area := Rectangle {
                vertical-stretch: 1;
                clip: true;
                if PlaylistState.playlist-list.length == 0: Text {
                    text: "No playlists";
                    color: Theme.fg-secondary;
                    x: 0;
                    y: 0;
                }
                if PlaylistState.playlist-list.length > 0: ListView {
                    vertical-stretch: 1;
                    for pl[i] in PlaylistState.playlist-list: VerticalLayout {
                        padding-bottom: Theme.spacing-sm;
                        PlaylistCard {
                            pl-name: pl.name;
                            track-count: pl.track-count;
                            selected: PlaylistState.selected-playlist == i;
                            drag-over: DragState.active && DragState.target-playlist >= 0 && DragState.target-playlist == i;
                            clicked => { PlaylistState.select-playlist(i); }
                        }
                    }
                }
            }

            if notification != "": Text {
                text: notification;
                color: Theme.warning;
            }
        }
    }
}
