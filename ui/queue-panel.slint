import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Track } from "types.slint";
import { TrackRow } from "track-row.slint";
import { PlaybackState } from "playback-state.slint";
import { ContextMenuState } from "context-menu-state.slint";
import { DragState } from "drag-state.slint";
import { PlaylistState } from "playlist-state.slint";
import { QueueState } from "queue-state.slint";

export component QueuePanel inherits Rectangle {

    callback toggle-queue();
    callback toggle-select(int);
    callback start-radio(int);
    callback start-artist(int);
    callback download-or-delete(int);
    callback remove-from-queue(int);
    callback reorder-queue(int, int);
    pure callback resolve-thumbnail(string) -> image;

    VerticalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-xs;

        HorizontalLayout {
            spacing: Theme.spacing-sm;
            Text { text: "Queue"; color: Theme.fg; font-weight: 700; }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "×"; color: Theme.fg-secondary;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { toggle-queue(); }
                }
            }
        }

        Text { text: "Now Playing"; color: Theme.accent; font-size: 12px; }

        Rectangle {
            height: 56px;
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                Rectangle {
                    width: 48px; height: 48px;
                    border-radius: Theme.radius-sm;
                    background: Theme.accent;
                    clip: true;
                    Image {
                        source: PlaybackState.current-thumbnail;
                        width: 48px; height: 48px;
                        image-fit: cover;
                    }
                }
                VerticalLayout {
                    Text { text: PlaybackState.current-title; color: Theme.fg; overflow: elide; }
                    Text { text: PlaybackState.current-artist; color: Theme.fg-secondary; overflow: elide; }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        Text { text: "Up Next"; color: Theme.accent; font-size: 12px; }

        qu-listview := ListView {
            viewport-y <=> DragState.qu-viewport-y;
            vertical-stretch: 1;
            for t[i] in QueueState.queue-tracks: TrackRow {
                track: t;
                thumbnail-image: root.resolve-thumbnail(t.thumbnail);
                idx: i;
                in-playlist: false;
                in-queue: true;

                row-clicked(index) => { root.toggle-select(index); }
                start-radio(index) => { root.start-radio(index); }
                start-artist(index) => { root.start-artist(index); }
                toggle-picker(index) => { PlaylistState.toggle-picker(index); }
                download-or-delete(index) => { root.download-or-delete(index); }
                remove-from-playlist(index) => { root.remove-from-queue(index); }
                right-clicked(index, abs-x, abs-y) => {
                    ContextMenuState.idx = index;
                    ContextMenuState.x = abs-x;
                    ContextMenuState.y = abs-y;
                    ContextMenuState.is-youtube = t.source == "youtube";
                    ContextMenuState.is-downloaded = t.is-downloaded;
                    ContextMenuState.in-queue = true;
                    ContextMenuState.show = true;
                }
                drag-pressed(index, abs-x, abs-y) => {
                    DragState.possible = true;
                    DragState.track-idx = index;
                    DragState.x = abs-x;
                    DragState.y = abs-y;
                    DragState.in-queue = true;
                    DragState.lv-y = qu-listview.y;
                    DragState.listview-width = qu-listview.width;
                    DragState.drop-idx = index;
                }
                drag-moved(index, abs-x, abs-y) => {
                    if (!DragState.possible) { return; }
                    if (!DragState.active) {
                        if (abs-x - DragState.x > 5px || DragState.x - abs-x > 5px || abs-y - DragState.y > 5px || DragState.y - abs-y > 5px) {
                            DragState.active = true;
                            DragState.reordering = true;
                        } else { return; }
                    }
                    DragState.x = abs-x;
                    DragState.y = abs-y;
                    if (DragState.reordering) {
                        let rel-y = abs-y - qu-listview.absolute-position.y;
                        let edge-zone = 40px;
                        if (rel-y < edge-zone) {
                            DragState.qu-viewport-y = min(0px, DragState.qu-viewport-y + 8px);
                        } else if (rel-y > qu-listview.height - edge-zone) {
                            let max-scroll = -(max(0px, QueueState.queue-tracks.length * 48px - qu-listview.height));
                            DragState.qu-viewport-y = max(max-scroll, DragState.qu-viewport-y - 8px);
                        }
                        DragState.drop-idx = max(0, min(QueueState.queue-tracks.length, (rel-y - DragState.qu-viewport-y) / 48px + 0.5));
                        DragState.drop-line-y = max(0px, min(qu-listview.height - 2px, DragState.drop-idx * 48px + DragState.qu-viewport-y));
                    }
                }
                drag-completed(index, abs-x, abs-y) => {
                    if (DragState.active && DragState.reordering && DragState.drop-idx != DragState.track-idx) {
                        root.reorder-queue(DragState.track-idx, DragState.drop-idx);
                    }
                    DragState.active = false;
                    DragState.reordering = false;
                    DragState.possible = false;
                }
            }
        }
    }

    if DragState.active && DragState.reordering && DragState.in-queue : Rectangle {
        x: 0px;
        y: DragState.lv-y + DragState.drop-line-y;
        width: DragState.listview-width;
        height: 2px;
        background: Theme.accent;
    }
}
