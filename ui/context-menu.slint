import { Theme } from "theme.slint";
import { ContextMenuState } from "context-menu-state.slint";
import { PlaylistState } from "playlist-state.slint";

export component ContextMenu inherits Rectangle {
    in property <length> parent-width;
    in property <length> parent-height;

    callback start-radio(int);
    callback start-artist(int);
    callback download-or-delete(int);
    callback remove-from-queue(int);

    property <bool> show-remove: ContextMenuState.in-playlist || ContextMenuState.in-queue;

    x: max(0px, min(ContextMenuState.x, parent-width - 190px));
    y: max(0px, min(ContextMenuState.y, parent-height - max(40px, Theme.spacing-xs * 2 + 36px + (ContextMenuState.is-youtube ? 108px : 0px) + (root.show-remove ? 36px : 0px) - Theme.spacing-xs)));
    width: 190px;
    height: max(40px, Theme.spacing-xs * 2 + 36px + (ContextMenuState.is-youtube ? 108px : 0px) + (root.show-remove ? 36px : 0px) - Theme.spacing-xs);
    background: Theme.bg-elevated;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: Theme.spacing-xs;
        spacing: Theme.spacing-xs;
        if ContextMenuState.is-youtube: Rectangle {
            height: 32px;
            border-radius: Theme.radius-sm;
            background: radio-touch.has-hover ? Theme.bg-hover : transparent;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: "Radio";
                    color: Theme.fg;
                    vertical-alignment: center;
                }
            }

            radio-touch := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.up) {
                        root.start-radio(ContextMenuState.idx);
                    }
                }
            }
        }
        if ContextMenuState.is-youtube: Rectangle {
            height: 32px;
            border-radius: Theme.radius-sm;
            background: artist-touch.has-hover ? Theme.bg-hover : transparent;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: "Artist";
                    color: Theme.fg;
                    vertical-alignment: center;
                }
            }

            artist-touch := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.up) {
                        root.start-artist(ContextMenuState.idx);
                    }
                }
            }
        }
        Rectangle {
            height: 32px;
            border-radius: Theme.radius-sm;
            background: pl-touch.has-hover ? Theme.bg-hover : transparent;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: "Add to Playlist";
                    color: Theme.fg;
                    vertical-alignment: center;
                }
            }

            pl-touch := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.up) {
                        PlaylistState.toggle-picker(ContextMenuState.idx);
                    }
                }
            }
        }

        if ContextMenuState.is-youtube: Rectangle {
            height: 32px;
            border-radius: Theme.radius-sm;
            background: dl-touch.has-hover ? Theme.bg-hover : transparent;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: ContextMenuState.is-downloaded ? "Delete Download" : "Download";
                    color: Theme.fg;
                    vertical-alignment: center;
                }
            }

            dl-touch := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.up) {
                        root.download-or-delete(ContextMenuState.idx);
                    }
                }
            }
        }
        if ContextMenuState.in-playlist: Rectangle {
            height: 32px;
            border-radius: Theme.radius-sm;
            background: remove-pl-touch.has-hover ? Theme.bg-hover : transparent;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: "Remove from Playlist";
                    color: Theme.fg;
                    vertical-alignment: center;
                }
            }

            remove-pl-touch := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.up) {
                        PlaylistState.remove-from-playlist(ContextMenuState.idx);
                    }
                }
            }
        }
        if ContextMenuState.in-queue: Rectangle {
            height: 32px;
            border-radius: Theme.radius-sm;
            background: remove-q-touch.has-hover ? Theme.bg-hover : transparent;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                Text {
                    text: "Remove from Queue";
                    color: Theme.fg;
                    vertical-alignment: center;
                }
            }

            remove-q-touch := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.up) {
                        root.remove-from-queue(ContextMenuState.idx);
                    }
                }
            }
        }
    }
}
