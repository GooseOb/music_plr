import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Track } from "types.slint";
import { TrackRow } from "track-row.slint";
import { PlaybackState } from "playback-state.slint";
import { ContextMenuState } from "context-menu-state.slint";
import { DragState } from "drag-state.slint";
import { SearchState } from "search-state.slint";

export component RadioView {
    in property <[Track]> radio-tracks;
    in property <string> radio-label;

    in property <int> playlist-count;
    in property <length> sidebar-list-abs-y;
    in property <length> sidebar-width;

    callback clear-search-focus();
    callback toggle-select(int);
    callback start-radio(int);
    callback start-artist(int);
    callback toggle-picker(int);
    callback download-or-delete(int);
    callback drag-add-to-playlist(int, int);
    pure callback resolve-thumbnail(string) -> image;

    property <int> focused-index: 0;

    VerticalLayout {
        vertical-stretch: 1;
        spacing: Theme.spacing-xs;
        if root.radio-label != "" : Text { text: root.radio-label; color: Theme.fg; }
        if SearchState.loading && root.radio-tracks.length == 0 : Text { text: "Loading recommendations..."; color: Theme.fg-secondary; }
        if root.radio-tracks.length > 0 : ListView {
            vertical-stretch: 1;
            for t[i] in root.radio-tracks: TrackRow {
                track: t;
                thumbnail-image: root.resolve-thumbnail(t.thumbnail);
                idx: i;
                keyboard-focused: radio-fs.has-focus && root.focused-index == i;
                in-playlist: false;
                in-queue: false;
                clear-search-focus => { root.clear-search-focus(); }
                row-clicked(index) => { root.toggle-select(index); }
                start-radio(index) => { root.start-radio(index); }
                start-artist(index) => { root.start-artist(index); }
                toggle-picker(index) => { root.toggle-picker(index); }
                download-or-delete(index) => { root.download-or-delete(index); }
                remove-from-playlist(index) => {}
                right-clicked(index, abs-x, abs-y) => {
                    ContextMenuState.idx = index;
                    ContextMenuState.x = abs-x;
                    ContextMenuState.y = abs-y;
                    ContextMenuState.is-youtube = t.source == "youtube";
                    ContextMenuState.is-downloaded = t.is-downloaded;
                    ContextMenuState.in-playlist = false;
                    ContextMenuState.show = true;
                }
                drag-pressed(index, abs-x, abs-y) => {
                    DragState.possible = true;
                    DragState.track-idx = index;
                    DragState.x = abs-x;
                    DragState.y = abs-y;
                }
                drag-moved(index, abs-x, abs-y) => {
                    if (!DragState.possible) { return; }
                    if (!DragState.active) {
                        if (abs-x - DragState.x > 5px || DragState.x - abs-x > 5px || abs-y - DragState.y > 5px || DragState.y - abs-y > 5px) {
                            DragState.active = true;
                        } else { return; }
                    }
                    DragState.x = abs-x;
                    DragState.y = abs-y;
                    DragState.over-sidebar = abs-x >= 0px && abs-x <= root.sidebar-width;
                    DragState.target-playlist = abs-x >= 0px && abs-x <= root.sidebar-width && root.playlist-count > 0 ? max(0, min(root.playlist-count - 1, (abs-y - root.sidebar-list-abs-y) / 44px)) : -1;
                }
                drag-completed(index, abs-x, abs-y) => {
                    if (DragState.active) {
                        if (DragState.target-playlist >= 0) {
                            root.drag-add-to-playlist(index, DragState.target-playlist);
                        }
                        DragState.active = false;
                        DragState.target-playlist = -1;
                        DragState.over-sidebar = false;
                    }
                    DragState.possible = false;
                }
            }
        }
        if root.radio-tracks.length == 0 && !SearchState.loading : Text {
            text: "Search for a song first, then use Radio or Artist";
            color: Theme.fg-secondary;
        }
    }

    radio-fs := FocusScope {
        width: 0px; height: 0px;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                root.focused-index = (root.focused-index + 1).min(root.radio-tracks.length - 1);
                accept
            } else if (event.text == Key.UpArrow) {
                root.focused-index = (root.focused-index - 1).max(0);
                accept
            } else if (event.text == Key.Return) {
                PlaybackState.play-track(root.focused-index);
                accept
            } else if (event.text == Key.Delete) {
                root.download-or-delete(root.focused-index);
                accept
            } else { reject }
        }
    }
}
