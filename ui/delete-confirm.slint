import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PlaylistState } from "playlist-state.slint";

export component DeleteConfirm inherits Rectangle {
    callback delete-playlist(int);
    callback close();

    background: Theme.overlay;
    TouchArea {
        clicked => {
			PlaylistState.show-delete-confirm = false;
			root.close();
        }
    }
    Rectangle {
        width: 300px;
        height: 140px;
        background: Theme.bg-elevated;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        VerticalLayout {
            padding: Theme.spacing-xl;
            spacing: Theme.spacing-md;
            Text { text: "Delete playlist?"; color: Theme.fg; font-weight: 700; }
            Text { text: "Tracks will not be deleted."; color: Theme.fg-secondary; }
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                alignment: center;
                horizontal-stretch: 1;
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Cancel"; clicked => { PlaylistState.show-delete-confirm = false; root.close(); } }
                Button { text: "Delete"; clicked => { PlaylistState.delete-playlist(PlaylistState.delete-confirm-index); PlaylistState.show-delete-confirm = false; root.close(); } }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
