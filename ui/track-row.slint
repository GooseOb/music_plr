import { Theme } from "theme.slint";
import { PlayIcon, PauseIcon, DownloadIcon, FolderIcon } from "icons.slint";
import { Track } from "types.slint";
import { PlaybackState } from "playback-state.slint";

export component TrackRow {
    in property <Track> track;
    in property <int> idx;
    in property <bool> keyboard-focused;
    in property <bool> in-playlist;
    in property <bool> in-queue: false;
    in property <bool> context-open: false;

    in property <image> thumbnail-image;

    callback clear-search-focus;
    callback row-clicked(int);
    callback right-clicked(int, length, length);
    callback start-radio(int);
    callback start-artist(int);
    callback toggle-picker(int);
    callback download-or-delete(int);
    callback remove-from-playlist(int);
    callback drag-pressed(int, length, length);
    callback drag-moved(int, length, length);
    callback drag-completed(int, length, length);

    property <bool> is-current: PlaybackState.current-track-id != "" && PlaybackState.current-track-id == track.id;
    property <bool> is-playing: is-current && PlaybackState.is-playing;

    Rectangle {
        horizontal-stretch: 1;
        background: keyboard-focused ? Theme.bg-hover : track.is-selected ? Theme.bg-selected : is-current ? Theme.bg-current : context-open ? Theme.bg-hover : touch-area.has-hover ? Theme.bg-hover : transparent;
        border-radius: Theme.radius-md;
        animate background { duration: 150ms; }

        touch-area := TouchArea {
            mouse-cursor: pointer;

            clicked => { root.clear-search-focus(); root.row-clicked(root.idx); }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                    root.right-clicked(root.idx, touch-area.absolute-position.x + touch-area.mouse-x, touch-area.absolute-position.y + touch-area.mouse-y);
                } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.drag-pressed(root.idx, touch-area.absolute-position.x + touch-area.mouse-x, touch-area.absolute-position.y + touch-area.mouse-y);
                } else if (event.kind == PointerEventKind.move) {
                    root.drag-moved(root.idx, touch-area.absolute-position.x + touch-area.mouse-x, touch-area.absolute-position.y + touch-area.mouse-y);
                } else if (event.kind == PointerEventKind.up) {
                    root.drag-completed(root.idx, touch-area.absolute-position.x + touch-area.mouse-x, touch-area.absolute-position.y + touch-area.mouse-y);
                }
            }
        }

        HorizontalLayout {
            padding-top: Theme.spacing-xs;
            padding-bottom: Theme.spacing-xs;
            padding-left: Theme.spacing-md;
            padding-right: Theme.spacing-md;
            spacing: Theme.spacing-sm;

            Rectangle {
                width: 30px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: Theme.radius-sm;
                        background: (touch-area.has-hover || is-current || play-click-area.has-hover) ? Theme.accent : transparent;
                        animate background { duration: 150ms; }
                        VerticalLayout {
                            alignment: center;
                            if (touch-area.has-hover || is-current || play-click-area.has-hover) && is-playing : PauseIcon { colorize: Theme.accent-fg; }
                            if (touch-area.has-hover || is-current || play-click-area.has-hover) && !is-playing : PlayIcon { colorize: Theme.accent-fg; }
                            if !(touch-area.has-hover || is-current || play-click-area.has-hover) : Text {
                                text: "\{root.idx + 1}";
                                color: Theme.fg-secondary;
                                font-size: 12px;
                            }
                        }
                        play-click-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if root.in-queue {
                                    PlaybackState.play-queue-track(root.idx);
                                } else {
                                    PlaybackState.play-track(root.idx);
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: Theme.radius-sm;
                background: Theme.accent;
                clip: true;
                Image {
                    source: thumbnail-image;
                    width: 36px;
                    height: 36px;
                    image-fit: cover;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: track.title;
                    color: Theme.fg;
                    overflow: elide;
                }
                Text {
                    text: track.artist;
                    color: Theme.fg-secondary;
                    overflow: elide;
                }
            }

            VerticalLayout {
                width: 24px;
                alignment: center;
                if track.is-downloaded : DownloadIcon { colorize: Theme.accent; }
                if !track.is-downloaded && track.source != "youtube" : FolderIcon { colorize: Theme.fg-secondary; }
            }

            VerticalLayout {
                width: 54px;
                alignment: center;
                Text {
                    text: track.duration-text;
                    color: Theme.fg-secondary;
                }
            }
        }
    }
}
