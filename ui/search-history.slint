import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DeleteIcon } from "icons.slint";
import { SearchState } from "search-state.slint";

export component SearchHistory inherits Rectangle {
    callback selected(int);
    callback delete-item(int);
    callback close();

    VerticalLayout {
        sh-fs := FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                if (event.text == Key.DownArrow) {
                    SearchState.search-history-focused-index = (SearchState.search-history-focused-index + 1).min(SearchState.search-history-items.length - 1);
                    accept
                } else if (event.text == Key.UpArrow) {
                    SearchState.search-history-focused-index = (SearchState.search-history-focused-index - 1).max(0);
                    accept
                } else if (event.text == Key.Return) {
                    root.selected(SearchState.search-history-focused-index);
                    accept
                } else if (event.text == Key.Delete) {
                    root.delete-item(SearchState.search-history-focused-index);
                    accept
                } else if (event.text == Key.Escape) {
                    root.close();
                    accept
                } else { reject }
            }

            ListView {
                vertical-stretch: 1;
                for h[i] in SearchState.search-history-items: Rectangle {
                    height: 36px;
                    border-radius: Theme.radius-md;
                    background: sh-fs.has-focus && SearchState.search-history-focused-index == i ? Theme.bg-hover.brighter(0.1) : Theme.bg-hover;
                    border-width: sh-fs.has-focus && SearchState.search-history-focused-index == i ? 1px : 0px;
                    border-color: Theme.accent;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected(i);
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-md;
                        spacing: Theme.spacing-xs;
                        Text { text: h; color: Theme.fg; horizontal-stretch: 1; vertical-stretch: 1; vertical-alignment: center; }
                        Rectangle {
                            width: 28px;
                            VerticalLayout {
                                alignment: center;
                                DeleteIcon { colorize: Theme.fg; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.up) {
                                        root.delete-item(i);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
